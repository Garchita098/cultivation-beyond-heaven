  },
  "notes": {
    "heroes": "RGBA with luminance-keyed alpha from #000000; ~768px tall; use additive aura shaders behind",
    "backgrounds": "720x1280 + 360x640 half-res; low-contrast center for UI overlay",
    "icons": "128x128 masters + _64.png half-res; RGBA keyed",
    "retries": [
      "hero_path_world_devourer: 2 retries for stronger void vortex (v3 accepted)"
    ],
    "weak_assets": [
      "hero_path_world_devourer: vortex improved but still more aura-halo than devouring maw",
      "icons/artifact_talisman: may contain abstract rune strokes (not readable letters)",
      "icons/artifact_lotus_seal: central geometric emblem may resemble a character form",
      "sheet_tabs research scroll had illegible celestial marks in source (abstract)"
    ],
    "webp": "Optional lighter WebP copies of backgrounds included alongside PNG (quality ~82); use PNG for Godot import if preferred.",
    "package": "cbh_art.tar.gz excludes raw/ generation sources; raw JPGs remain on disk under /workspace/cbh_art/raw/"
  },
